{
    "name": "ekowabaka/ui",
    "description": "Fahodzi UI component and styling library",
    "type": "library",
    "keywords": [
        "ui",
        "fahodzi",
        "components",
        "frontend",
        "css",
        "scss",
        "javascript",
        "web-components",
        "custom-elements",
        "design-system"
    ],
    "homepage": "https://github.com/ekowabaka/ui",
    "readme": "README.md",
    "license": "MIT",
    "authors": [
        {
            "name": "James Ekow Abaka Ainooson",
            "email": "jainooson@gmail.com",
            "homepage": "https://github.com/ekowabaka",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ekowabaka/ui/issues",
        "source": "https://github.com/ekowabaka/ui",
        "docs": "https://github.com/ekowabaka/ui#readme"
    },
    "replace": {
        "fahodzi/ui": "self.version",
        "ekowabaka/fzui": "self.version"
    },
    "require": {},
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "build": "npm run build",
        "build:examples": "npm run build:examples",
        "build:all": "npm run build:all"
    },
    "archive": {
        "exclude": [
            "/.*",
            "/demo",
            "/examples",
            "/node_modules",
            "webpack*.config.js"
        ]
    }
}
