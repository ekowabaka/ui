<div class="component-header">
    <h2>Avatars</h2>
    <p>Avatars are used to display a user's profile picture in five sizes: mini, small, default, large, and mega.</p>
</div>

<section class="component" style="display: flex; gap: 2.5em; align-items: flex-end; justify-content: flex-start; flex-wrap: wrap;">
    <div>
        <p style="font-size: 0.85em; color: #666; margin-bottom: 0.5em;">Mini (<code>.avatar--mini</code> / <code>size="mini"</code>)</p>
        <fz-avatar size="mini" class="avatar--mini">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <p style="font-size: 0.85em; color: #666; margin-bottom: 0.5em;">Small (<code>.avatar--small</code> / <code>size="small"</code>)</p>
        <fz-avatar size="small" class="avatar--small">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <p style="font-size: 0.85em; color: #666; margin-bottom: 0.5em;">Default (<code>.avatar</code> / <code>size="default"</code>)</p>
        <fz-avatar>
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <p style="font-size: 0.85em; color: #666; margin-bottom: 0.5em;">Large (<code>.avatar--large</code> / <code>size="large"</code>)</p>
        <fz-avatar size="large" class="avatar--large">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <p style="font-size: 0.85em; color: #666; margin-bottom: 0.5em;">Mega (<code>.avatar--mega</code> / <code>size="mega"</code>)</p>
        <fz-avatar size="mega" class="avatar--mega">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>
</section>
