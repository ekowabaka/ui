    </div>

    <div>
        <fz-avatar>
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <fz-avatar size="large" class="avatar--large">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
            <span slot="subname">Software Engineer</span>
        </fz-avatar>
    </div>

    <div>
        <fz-avatar size="mega" class="avatar--mega">
