<div class="component-header">
    <h2>Buttons</h2>
    <p>Button styles and variations with support for colors, outlines, sizes, and layers via classes and attributes.</p>
</div>
<section class="component">
    <div class="variant half">
        <h3>Colours (via color="..." & boolean attributes)</h3>
        <section class="buttons">
            <button>Default</button>
            <button color="red">Red</button>
            <button color="yellow">Yellow</button>
            <button color="blue">Blue</button>
            <button green>Green</button>
            <button brown>Brown</button>
            <button purple>Purple</button>
        </section>
    </div>

    <div class="variant half">
        <h3>Outlines</h3>
        <section class="buttons">
            <button outline>Default</button>
            <button outline color="red">Red</button>
            <button outline color="yellow">Yellow</button>
            <button outline color="blue">Blue</button>
            <button outline green>Green</button>
            <button outline brown>Brown</button>
            <button outline purple>Purple</button>
        </section>
    </div>

    <div class="variant half">
        <h3>Layers (2 Levels: 0=Flat, 1=Default)</h3>
        <section class="buttons">
            <button color="blue" layer="0">Layer 0 (Flat)</button>
            <button color="blue" layer="1">Layer 1 (Default)</button>
            <button color="green" layer="0">Layer 0 (Flat)</button>
            <button color="green" layer="1">Layer 1 (Default)</button>
        </section>
    </div>

    <div class="variant half">
        <h3>Sizes (via size="..." & attributes)</h3>
        <section class="buttons">
            <button color="blue" size="mini">Mini</button>
            <button color="blue" size="small">Small</button>
            <button color="blue">Default</button>
            <button color="blue" size="large">Large</button>
            <button color="blue" size="mega">Mega</button>
        </section>
    </div>

    <div class="variant half">
        <h3>Outlines Sizes</h3>
        <section class="buttons">
            <button color="blue" outline size="mini">Mini</button>
            <button color="blue" outline size="small">Small</button>
            <button color="blue" outline>Default</button>
            <button color="blue" outline size="large">Large</button>
            <button color="blue" outline size="mega">Mega</button>
        </section>
    </div>
</section>
