<div class="component-header">
    <h2>Layouts</h2>
    <p>Layouts are used to structure the content of a web page.</p>
</div>
<div style="border:1px solid #ccc; height: 500px">
    <fz-app-frame>
        <fz-avatar slot="topnav" size="small">
            <img slot="image" src="assets/avatar.jpg" alt="User Avatar">
            <span slot="name">John Doe</span>
        </fz-avatar>
        <div slot="search" style="text-align:center">
            <input placeholder="Search..." size="small"></input>
        </div>
        <span slot="logo">My App</span>
        <fz-sidebar slot="sidebar" color="green">
            <fz-sidebar-item selected><span slot="icon" class="material-symbols-outlined">dashboard</span>Dashboard</fz-sidebar-item>
            <fz-sidebar-item>
                <span slot="icon" class="material-symbols-outlined">folder</span>Settings
                <fz-sidebar>
                    <fz-sidebar-item><span slot="icon" class="material-symbols-outlined">settings</span>General</fz-sidebar-item>
                    <fz-sidebar-item><span slot="icon" class="material-symbols-outlined">shield</span>Security</fz-sidebar-item>
                </fz-sidebar>
            </fz-sidebar-item>
            <fz-sidebar-item><span slot="icon" class="material-symbols-outlined">person</span>Profile</fz-sidebar-item>
        </fz-sidebar>
        <div style="padding: 10px">
            <h3>Dashboard</h3>
            <p>This content is placed in the default slot.</p>
        </div>
    </fz-app-frame>
</div>
