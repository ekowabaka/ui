{
  "name": "@ekowabaka/ui",
  "version": "0.2.0",
  "description": "Fahodzi UI component and styling library",
  "type": "module",
  "main": "dist/fzui.js",
  "module": "dist/fzui.js",
  "style": "dist/fzui.css",
  "files": [
    "dist",
    "js",
    "sass"
  ],
  "exports": {
    ".": {
      "import": "./dist/fzui.js",
      "default": "./dist/fzui.js"
    },
    "./css": "./dist/fzui.css",
    "./css/*": "./dist/css/*.css",
    "./sass/*": "./sass/*"
  },
  "scripts": {
    "build": "webpack",
    "build:examples": "webpack --config webpack-example.config.js",
    "build:all": "webpack && webpack --config webpack-example.config.js",
    "watch": "webpack --watch",
    "watch:examples": "webpack --config webpack-example.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekowabaka/ui.git"
  },
  "keywords": [
    "ui",
    "fahodzi",
    "web-components",
    "components",
    "frontend",
    "css",
    "sass",
    "javascript"
  ],
  "author": "James Ekow Abaka Ainooson <jainooson@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ekowabaka/ui/issues"
  },
  "homepage": "https://github.com/ekowabaka/ui#readme",
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "handlebars": "^4.7.9",
    "handlebars-loader": "^1.7.3",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "mustache": "^4.2.0",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "to-string-loader": "^1.2.0",
    "webpack": "^5.110.1",
    "webpack-cli": "^7.2.3"
  }
}
